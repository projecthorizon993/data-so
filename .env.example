# --- Backend env (set where server.js / the NIM proxy runs) ---
# Your NIM host: self-hosted GPU box, or NVIDIA hosted API.
NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Optional (if NIM requires auth):
NIM_API_KEY=
# Optional (verified working with this key; defaults to deepseek flash):
NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731
