# --- Vercel env (Project > Settings > Environment Variables) ---
# Required: your GPU/NIM host (RunPod / Lambda / self-host). Edge fn proxies to it.
NIM_API_URL=https://your-nim-host:8000/v1/chat/completions
# Optional (if NIM requires auth):
NIM_API_KEY=
# Optional (defaults to meta/llama-3.1-8b-instruct):
NIM_MODEL=meta/llama-3.1-8b-instruct
