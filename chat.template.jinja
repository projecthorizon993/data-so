{# Chat template — fixed short prefix keeps token count low (plan tip #1). #}
{{- bos_token -}}
{%- if messages[0]['role'] == 'system' -%}
{{- 'System: ' + messages[0]['content'] + '\n' -}}
{%- endif -%}
{%- for m in messages[1:] -%}
{%- if m['role'] == 'user' -%}
{{- 'User: ' + m['content'] + '\n' -}}
{%- else -%}
{{- 'Assistant: ' + m['content'] + '\n' -}}
{%- endif -%}
{%- endfor -%}
{{- 'Assistant:' -}}
